{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "noEmitOnError": true, "declaration": true, "emitDeclarationOnly": true,
    "rootDir": "src", "outDir": "dist", "lib": ["ES2022", "DOM"], "skipLibCheck": true
  },
  "include": ["src"]
}
