# EXAMPLE ONLY. Copy to a private file outside the repository and replace values.
# These are explicit operational targets, not automatic plugin configuration.
DSH_HOME=/absolute/path/to/dsh-home
DSH_LOCAL_ORIGIN=http://127.0.0.1:12052
DSH_LOGIN_ORIGIN=https://your-device.example.net
DSH_SERVICE=your-dsh.service
DSH_REVOKE_ORIGINS='["http://127.0.0.1:12052","https://your-device.example.net"]'
# Optional: otherwise discover dsh on PATH and use locally installed Playwright.
# DSH_BIN=/absolute/path/to/dsh/lib/bin.js
# PLAYWRIGHT_MODULE=/absolute/path/to/playwright/index.mjs
# CHROME_PATH=/absolute/path/to/chrome
